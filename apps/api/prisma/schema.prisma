generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model broker_profiles {
  id                     BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                BigInt                 @unique(map: "uq_broker_user") @db.UnsignedBigInt
  master_broker_id       BigInt                 @db.UnsignedBigInt
  address                String                 @db.Text
  city                   String                 @db.VarChar(100)
  pan_encrypted          String?                @db.Text
  aadhaar_encrypted      String?                @db.Text
  firm_name              String?                @db.VarChar(150)
  rera_number            String?                @db.VarChar(100)
  bank_holder_name       String?                @db.VarChar(150)
  bank_name              String?                @db.VarChar(150)
  bank_account_encrypted String?                @db.Text
  bank_ifsc              String?                @db.VarChar(11)
  created_at             DateTime               @db.DateTime(0)
  updated_at             DateTime               @db.DateTime(0)
  master_broker_profiles master_broker_profiles @relation(fields: [master_broker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_broker_master_broker")
  users                  users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_broker_user")

  @@index([master_broker_id], map: "idx_broker_master_broker")
}

model broker_referrals {
  id                     BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  master_broker_id       BigInt                 @db.UnsignedBigInt
  token_hash             String                 @unique(map: "uq_broker_referrals_token") @db.Char(64)
  expires_at             DateTime               @db.DateTime(0)
  revoked_at             DateTime?              @db.DateTime(0)
  created_at             DateTime               @db.DateTime(0)
  master_broker_profiles master_broker_profiles @relation(fields: [master_broker_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_broker_referrals_master_broker")

  @@index([master_broker_id, revoked_at, expires_at], map: "idx_broker_referrals_master_broker")
}

model ci_sessions {
  id         String @id @db.VarChar(128)
  ip_address String @db.VarChar(45)
  timestamp  Int    @default(0) @db.UnsignedInt
  data       Bytes  @db.Blob

  @@index([timestamp], map: "idx_ci_sessions_timestamp")
}

model employee_profiles {
  id                     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                BigInt   @unique(map: "uq_employee_user") @db.UnsignedBigInt
  address                String   @db.Text
  city                   String   @db.VarChar(100)
  pan_encrypted          String?  @db.Text
  aadhaar_encrypted      String?  @db.Text
  designation            String   @db.VarChar(100)
  joining_date           DateTime @db.Date
  bank_holder_name       String?  @db.VarChar(150)
  bank_name              String?  @db.VarChar(150)
  bank_account_encrypted String?  @db.Text
  bank_ifsc              String?  @db.VarChar(11)
  created_at             DateTime @db.DateTime(0)
  updated_at             DateTime @db.DateTime(0)
  users                  users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee_user")
}

model identity_documents {
  id            BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt                           @db.UnsignedBigInt
  document_type identity_documents_document_type
  document_hash String                           @db.Char(64)
  created_at    DateTime                         @db.DateTime(0)
  users         users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_identity_documents_user")

  @@unique([document_type, document_hash], map: "uq_identity_documents_type_hash")
  @@index([user_id], map: "idx_identity_documents_user")
}

model uploaded_documents {
  id            BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt                           @db.UnsignedBigInt
  document_type identity_documents_document_type
  storage_path  String                           @db.VarChar(500)
  original_name String                           @db.VarChar(255)
  mime_type     String                           @db.VarChar(100)
  size_bytes    Int                              @db.UnsignedInt
  created_at    DateTime                         @db.DateTime(0)
  users         users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_uploaded_documents_user")

  @@unique([user_id, document_type], map: "uq_uploaded_documents_user_type")
  @@index([document_type], map: "idx_uploaded_documents_type")
}

model login_attempts {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt?               @db.UnsignedBigInt
  identifier_hash String                @db.Char(64)
  ip_address      String                @db.VarChar(45)
  user_agent      String                @db.VarChar(500)
  status          login_attempts_status
  failure_reason  String?               @db.VarChar(100)
  created_at      DateTime              @db.DateTime(0)
  users           users?                @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_login_attempt_user")

  @@index([user_id], map: "fk_login_attempt_user")
  @@index([identifier_hash, created_at], map: "idx_login_attempt_identifier")
  @@index([ip_address, created_at], map: "idx_login_attempt_ip")
}

model master_broker_profiles {
  id                                                     BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                                                BigInt             @unique(map: "uq_master_broker_user") @db.UnsignedBigInt
  created_by_user_id                                     BigInt?            @db.UnsignedBigInt
  address                                                String             @db.Text
  city                                                   String             @db.VarChar(100)
  pan_encrypted                                          String?            @db.Text
  aadhaar_encrypted                                      String?            @db.Text
  firm_name                                              String?            @db.VarChar(150)
  commission_percentage                                  Decimal            @db.Decimal(5, 2)
  bank_holder_name                                       String?            @db.VarChar(150)
  bank_name                                              String?            @db.VarChar(150)
  bank_account_encrypted                                 String?            @db.Text
  bank_ifsc                                              String?            @db.VarChar(11)
  created_at                                             DateTime           @db.DateTime(0)
  updated_at                                             DateTime           @db.DateTime(0)
  broker_profiles                                        broker_profiles[]
  broker_referrals                                       broker_referrals[]
  users_master_broker_profiles_created_by_user_idTousers users?             @relation("master_broker_profiles_created_by_user_idTousers", fields: [created_by_user_id], references: [id], onUpdate: NoAction, map: "fk_master_broker_creator")
  users_master_broker_profiles_user_idTousers            users              @relation("master_broker_profiles_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_master_broker_user")

  @@index([created_by_user_id], map: "idx_master_broker_creator")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model migrations {
  version BigInt

  @@ignore
}

model password_resets {
  id           BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt                  @db.UnsignedBigInt
  token_hash   String                  @unique(map: "uq_password_resets_token") @db.Char(64)
  purpose      password_resets_purpose
  expires_at   DateTime                @db.DateTime(0)
  used_at      DateTime?               @db.DateTime(0)
  requested_ip String                  @db.VarChar(45)
  created_at   DateTime                @db.DateTime(0)
  users        users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_resets_user")

  @@index([user_id, purpose], map: "idx_password_resets_user")
}

model permissions {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  code             String             @unique(map: "uq_permissions_code") @db.VarChar(100)
  name             String             @db.VarChar(150)
  created_at       DateTime           @db.DateTime(0)
  updated_at       DateTime           @db.DateTime(0)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       BigInt      @db.UnsignedBigInt
  permission_id BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_role_permissions_permission")
}

model roles {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  code             String             @unique(map: "uq_roles_code") @db.VarChar(50)
  name             String             @db.VarChar(100)
  created_at       DateTime           @db.DateTime(0)
  updated_at       DateTime           @db.DateTime(0)
  role_permissions role_permissions[]
  users            users[]
}

model security_logs {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt?  @db.UnsignedBigInt
  event_type    String   @db.VarChar(100)
  ip_address    String   @db.VarChar(45)
  user_agent    String   @db.VarChar(500)
  metadata_json Json?
  created_at    DateTime @db.DateTime(0)
  users         users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_security_logs_user")

  @@index([user_id, event_type, created_at], map: "idx_security_logs_user_event")
}

model user_sessions {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt    @db.UnsignedBigInt
  session_id_hash String    @unique(map: "uq_user_sessions_hash") @db.Char(64)
  session_version Int       @db.UnsignedInt
  ip_address      String    @db.VarChar(45)
  user_agent      String    @db.VarChar(500)
  last_seen_at    DateTime  @db.DateTime(0)
  expires_at      DateTime  @db.DateTime(0)
  revoked_at      DateTime? @db.DateTime(0)
  created_at      DateTime  @db.DateTime(0)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_sessions_user")

  @@index([user_id, revoked_at], map: "idx_user_sessions_user")
}

model users {
  id                                                                      BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                                                                    String                   @unique(map: "uq_users_uuid") @db.Char(36)
  user_code                                                               String?                  @unique(map: "uq_users_user_code") @db.VarChar(20)
  role_id                                                                 BigInt                   @db.UnsignedBigInt
  name                                                                    String                   @db.VarChar(150)
  email                                                                   String?                  @unique(map: "uq_users_email") @db.VarChar(254)
  mobile                                                                  String                   @unique(map: "uq_users_mobile") @db.VarChar(15)
  password_hash                                                           String?                  @db.VarChar(255)
  status                                                                  users_status             @default(PENDING)
  is_verified                                                             Boolean                  @default(false)
  last_login_at                                                           DateTime?                @db.DateTime(0)
  last_login_ip                                                           String?                  @db.VarChar(45)
  failed_login_attempts                                                   Int                      @default(0) @db.UnsignedSmallInt
  locked_until                                                            DateTime?                @db.DateTime(0)
  password_changed_at                                                     DateTime?                @db.DateTime(0)
  session_version                                                         Int                      @default(1) @db.UnsignedInt
  created_at                                                              DateTime                 @db.DateTime(0)
  updated_at                                                              DateTime                 @db.DateTime(0)
  deleted_at                                                              DateTime?                @db.DateTime(0)
  broker_profiles                                                         broker_profiles?
  employee_profiles                                                       employee_profiles?
  identity_documents                                                      identity_documents[]
  uploaded_documents                                                      uploaded_documents[]
  login_attempts                                                          login_attempts[]
  master_broker_profiles_master_broker_profiles_created_by_user_idTousers master_broker_profiles[] @relation("master_broker_profiles_created_by_user_idTousers")
  master_broker_profiles_master_broker_profiles_user_idTousers            master_broker_profiles?  @relation("master_broker_profiles_user_idTousers")
  password_resets                                                         password_resets[]
  security_logs                                                           security_logs[]
  user_sessions                                                           user_sessions[]
  roles                                                                   roles                    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")

  @@index([role_id, status], map: "idx_users_role_status")
}

enum identity_documents_document_type {
  PAN
  AADHAAR
}

enum password_resets_purpose {
  ACTIVATION
  RESET
}

enum login_attempts_status {
  SUCCESS
  FAILURE
  LOCKED
}

enum users_status {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}
