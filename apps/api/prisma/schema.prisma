generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model broker_profiles {
  id                     BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                BigInt           @unique(map: "uq_broker_user") @db.UnsignedBigInt
  parent_broker_id       BigInt?          @db.UnsignedBigInt
  created_by_user_id     BigInt?          @db.UnsignedBigInt
  address                String           @db.Text
  city                   String           @db.VarChar(100)
  pan_encrypted          String?          @db.Text
  aadhaar_encrypted      String?          @db.Text
  firm_name              String?          @db.VarChar(150)
  rera_number            String?          @db.VarChar(100)
  commission_percentage  Decimal          @default(0) @db.Decimal(5, 2)
  bank_holder_name       String?          @db.VarChar(150)
  bank_name              String?          @db.VarChar(150)
  bank_account_encrypted String?          @db.Text
  bank_ifsc              String?          @db.VarChar(11)
  created_at             DateTime         @db.DateTime(0)
  updated_at             DateTime         @db.DateTime(0)
  creator                users?           @relation("broker_profiles_created_by", fields: [created_by_user_id], references: [id], onUpdate: NoAction, map: "fk_broker_creator")
  parent                 broker_profiles? @relation("broker_parent_broker", fields: [parent_broker_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_broker_parent_broker")
  users                  users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_broker_user")
  broker_referrals       broker_referrals[]
  downline               broker_profiles[] @relation("broker_parent_broker")

  @@index([parent_broker_id], map: "idx_broker_parent_broker")
  @@index([created_by_user_id], map: "idx_broker_creator")
}

model broker_referrals {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  broker_id       BigInt          @db.UnsignedBigInt
  token_hash      String          @unique(map: "uq_broker_referrals_token") @db.Char(64)
  expires_at      DateTime        @db.DateTime(0)
  revoked_at      DateTime?       @db.DateTime(0)
  created_at      DateTime        @db.DateTime(0)
  broker_profiles broker_profiles @relation(fields: [broker_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_broker_referrals_broker")

  @@index([broker_id, revoked_at, expires_at], map: "idx_broker_referrals_broker")
}

model ci_sessions {
  id         String @id @db.VarChar(128)
  ip_address String @db.VarChar(45)
  timestamp  Int    @default(0) @db.UnsignedInt
  data       Bytes  @db.Blob

  @@index([timestamp], map: "idx_ci_sessions_timestamp")
}

model employee_profiles {
  id                     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id                BigInt   @unique(map: "uq_employee_user") @db.UnsignedBigInt
  address                String   @db.Text
  city                   String   @db.VarChar(100)
  pan_encrypted          String?  @db.Text
  aadhaar_encrypted      String?  @db.Text
  designation            String   @db.VarChar(100)
  joining_date           DateTime @db.Date
  bank_holder_name       String?  @db.VarChar(150)
  bank_name              String?  @db.VarChar(150)
  bank_account_encrypted String?  @db.Text
  bank_ifsc              String?  @db.VarChar(11)
  created_at             DateTime @db.DateTime(0)
  updated_at             DateTime @db.DateTime(0)
  users                  users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee_user")
}

model identity_documents {
  id            BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt                           @db.UnsignedBigInt
  document_type identity_documents_document_type
  document_hash String                           @db.Char(64)
  created_at    DateTime                         @db.DateTime(0)
  users         users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_identity_documents_user")

  @@unique([document_type, document_hash], map: "uq_identity_documents_type_hash")
  @@index([user_id], map: "idx_identity_documents_user")
}

model uploaded_documents {
  id            BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt                           @db.UnsignedBigInt
  document_type identity_documents_document_type
  storage_path  String                           @db.VarChar(500)
  original_name String                           @db.VarChar(255)
  mime_type     String                           @db.VarChar(100)
  size_bytes    Int                              @db.UnsignedInt
  created_at    DateTime                         @db.DateTime(0)
  users         users                            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_uploaded_documents_user")

  @@unique([user_id, document_type], map: "uq_uploaded_documents_user_type")
  @@index([document_type], map: "idx_uploaded_documents_type")
}

model login_attempts {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt?               @db.UnsignedBigInt
  identifier_hash String                @db.Char(64)
  ip_address      String                @db.VarChar(45)
  user_agent      String                @db.VarChar(500)
  status          login_attempts_status
  failure_reason  String?               @db.VarChar(100)
  created_at      DateTime              @db.DateTime(0)
  users           users?                @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_login_attempt_user")

  @@index([user_id], map: "fk_login_attempt_user")
  @@index([identifier_hash, created_at], map: "idx_login_attempt_identifier")
  @@index([ip_address, created_at], map: "idx_login_attempt_ip")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model migrations {
  version BigInt

  @@ignore
}

model password_resets {
  id           BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt                  @db.UnsignedBigInt
  token_hash   String                  @unique(map: "uq_password_resets_token") @db.Char(64)
  purpose      password_resets_purpose
  expires_at   DateTime                @db.DateTime(0)
  used_at      DateTime?               @db.DateTime(0)
  requested_ip String                  @db.VarChar(45)
  created_at   DateTime                @db.DateTime(0)
  users        users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_password_resets_user")

  @@index([user_id, purpose], map: "idx_password_resets_user")
}

model projects {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  uuid               String              @unique(map: "uq_projects_uuid") @db.Char(36)
  code               String?             @unique(map: "uq_projects_code") @db.VarChar(50)
  name               String              @db.VarChar(200)
  description        String?             @db.Text
  address            String?             @db.Text
  city               String?             @db.VarChar(100)
  state              String?             @db.VarChar(100)
  latitude           Decimal             @db.Decimal(10, 7)
  longitude          Decimal             @db.Decimal(10, 7)
  blocks             Json?
  society_drawing    Json?
  society_boundary   Json?
  facility_labels    Json?
  created_by_user_id BigInt?             @db.UnsignedBigInt
  created_at         DateTime            @db.DateTime(0)
  updated_at         DateTime            @db.DateTime(0)
  deleted_at         DateTime?           @db.DateTime(0)
  plot_enquiries     plot_enquiries[]
  project_documents  project_documents[]
  project_plots      project_plots[]
  users              users?              @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction, map: "fk_projects_creator")

  @@index([created_by_user_id], map: "idx_projects_creator")
  @@index([deleted_at], map: "idx_projects_deleted")
}

model project_plots {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  uuid              String              @unique(map: "uq_project_plots_uuid") @db.Char(36)
  project_id        BigInt              @db.UnsignedBigInt
  block_id          String?             @db.VarChar(100)
  plot_no           String              @db.VarChar(50)
  status            project_plot_status @default(AVAILABLE)
  plot_type         project_plot_type   @default(NORMAL)
  color             String?             @db.VarChar(20)
  area_sqft         Decimal?            @db.Decimal(12, 2)
  area_sqm          Decimal?            @db.Decimal(12, 2)
  perimeter_meters  Decimal?            @db.Decimal(12, 2)
  frontage_meters   Decimal?            @db.Decimal(12, 2)
  depth_meters      Decimal?            @db.Decimal(12, 2)
  side_lengths      Json?
  facing            String?             @db.VarChar(50)
  road_width_meters Decimal?            @db.Decimal(12, 2)
  price             Decimal?            @db.Decimal(14, 2)
  geometry          Json
  created_at        DateTime            @db.DateTime(0)
  updated_at        DateTime            @db.DateTime(0)
  plot_enquiries    plot_enquiries[]
  projects          projects            @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_plots_project")

  @@index([project_id], map: "idx_project_plots_project")
}

model plot_enquiries {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  uuid               String         @unique(map: "uq_plot_enquiries_uuid") @db.Char(36)
  project_id         BigInt         @db.UnsignedBigInt
  plot_id            BigInt         @db.UnsignedBigInt
  customer_name      String         @db.VarChar(200)
  phone              String         @db.VarChar(30)
  email              String?        @db.VarChar(200)
  message            String?        @db.Text
  status             enquiry_status @default(NEW)
  created_by_user_id BigInt?        @db.UnsignedBigInt
  created_at         DateTime       @db.DateTime(0)
  updated_at         DateTime       @db.DateTime(0)
  users              users?         @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction, map: "fk_plot_enquiries_creator")
  project_plots      project_plots  @relation(fields: [plot_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_plot_enquiries_plot")
  projects           projects       @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_plot_enquiries_project")

  @@index([project_id], map: "idx_plot_enquiries_project")
  @@index([plot_id], map: "idx_plot_enquiries_plot")
  @@index([status], map: "idx_plot_enquiries_status")
  @@index([created_by_user_id], map: "fk_plot_enquiries_creator")
}

model enquiries {
  id                  BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                String         @unique(map: "uq_enquiries_uuid") @db.Char(36)
  customer_name       String         @db.VarChar(200)
  phone               String         @db.VarChar(30)
  email               String?        @db.VarChar(200)
  remarks             String?        @db.Text
  status              enquiry_status @default(NEW)
  created_by_user_id  BigInt?        @db.UnsignedBigInt
  assigned_to_user_id BigInt?        @db.UnsignedBigInt
  mobile_verified_at  DateTime?      @db.DateTime(0)
  hidden_at           DateTime?      @db.DateTime(0)
  created_at          DateTime       @db.DateTime(0)
  updated_at          DateTime       @db.DateTime(0)
  assignee            users?         @relation("enquiries_assigned_to", fields: [assigned_to_user_id], references: [id], onUpdate: NoAction, map: "fk_enquiries_assignee")
  creator             users?         @relation("enquiries_created_by", fields: [created_by_user_id], references: [id], onUpdate: NoAction, map: "fk_enquiries_creator")

  @@index([phone, hidden_at], map: "idx_enquiries_phone")
  @@index([assigned_to_user_id, status], map: "idx_enquiries_assignee")
  @@index([status], map: "idx_enquiries_status")
  @@index([created_at], map: "idx_enquiries_created")
  @@index([created_by_user_id], map: "fk_enquiries_creator")
}

model project_documents {
  id            BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String                @unique(map: "uq_project_documents_uuid") @db.Char(36)
  project_id    BigInt                @db.UnsignedBigInt
  kind          project_document_kind
  storage_path  String                @db.VarChar(500)
  original_name String                @db.VarChar(255)
  mime_type     String                @db.VarChar(100)
  size_bytes    Int                   @db.UnsignedInt
  sort_order    Int                   @default(0) @db.UnsignedInt
  created_at    DateTime              @db.DateTime(0)
  projects      projects              @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_documents_project")

  @@index([project_id, kind], map: "idx_project_documents_project")
}

model plot_templates {
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String              @unique(map: "uq_plot_templates_uuid") @db.Char(36)
  name       String              @db.VarChar(200)
  shape      plot_template_shape
  dimensions Json
  created_at DateTime            @db.DateTime(0)
  updated_at DateTime            @db.DateTime(0)

  @@index([created_at], map: "idx_plot_templates_created")
}

model permissions {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  code             String             @unique(map: "uq_permissions_code") @db.VarChar(100)
  name             String             @db.VarChar(150)
  created_at       DateTime           @db.DateTime(0)
  updated_at       DateTime           @db.DateTime(0)
  role_permissions role_permissions[]
}

model role_permissions {
  role_id       BigInt      @db.UnsignedBigInt
  permission_id BigInt      @db.UnsignedBigInt
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_role_permissions_permission")
}

model roles {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  code             String             @unique(map: "uq_roles_code") @db.VarChar(50)
  name             String             @db.VarChar(100)
  created_at       DateTime           @db.DateTime(0)
  updated_at       DateTime           @db.DateTime(0)
  role_permissions role_permissions[]
  users            users[]
}

model security_logs {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt?  @db.UnsignedBigInt
  event_type    String   @db.VarChar(100)
  ip_address    String   @db.VarChar(45)
  user_agent    String   @db.VarChar(500)
  metadata_json Json?
  created_at    DateTime @db.DateTime(0)
  users         users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_security_logs_user")

  @@index([user_id, event_type, created_at], map: "idx_security_logs_user_event")
}

model user_sessions {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt    @db.UnsignedBigInt
  session_id_hash String    @unique(map: "uq_user_sessions_hash") @db.Char(64)
  session_version Int       @db.UnsignedInt
  ip_address      String    @db.VarChar(45)
  user_agent      String    @db.VarChar(500)
  last_seen_at    DateTime  @db.DateTime(0)
  expires_at      DateTime  @db.DateTime(0)
  revoked_at      DateTime? @db.DateTime(0)
  created_at      DateTime  @db.DateTime(0)
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_sessions_user")

  @@index([user_id, revoked_at], map: "idx_user_sessions_user")
}

model users {
  id                           BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                         String                   @unique(map: "uq_users_uuid") @db.Char(36)
  user_code                    String?                  @unique(map: "uq_users_user_code") @db.VarChar(20)
  role_id                      BigInt                   @db.UnsignedBigInt
  name                         String                   @db.VarChar(150)
  email                        String?                  @unique(map: "uq_users_email") @db.VarChar(254)
  mobile                       String                   @unique(map: "uq_users_mobile") @db.VarChar(15)
  password_hash                String?                  @db.VarChar(255)
  status                       users_status             @default(PENDING)
  is_verified                  Boolean                  @default(false)
  last_login_at                DateTime?                @db.DateTime(0)
  last_login_ip                String?                  @db.VarChar(45)
  failed_login_attempts        Int                      @default(0) @db.UnsignedSmallInt
  locked_until                 DateTime?                @db.DateTime(0)
  password_changed_at          DateTime?                @db.DateTime(0)
  session_version              Int                      @default(1) @db.UnsignedInt
  created_at                   DateTime                 @db.DateTime(0)
  updated_at                   DateTime                 @db.DateTime(0)
  deleted_at                   DateTime?                @db.DateTime(0)
  broker_profiles              broker_profiles?
  broker_profiles_created_by   broker_profiles[]        @relation("broker_profiles_created_by")
  employee_profiles            employee_profiles?
  enquiries_assigned_to        enquiries[]              @relation("enquiries_assigned_to")
  enquiries_created_by         enquiries[]              @relation("enquiries_created_by")
  identity_documents           identity_documents[]
  login_attempts               login_attempts[]
  password_resets              password_resets[]
  plot_enquiries               plot_enquiries[]
  projects                     projects[]
  security_logs                security_logs[]
  uploaded_documents           uploaded_documents[]
  user_sessions                user_sessions[]
  roles                        roles                    @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_role")

  @@index([role_id, status], map: "idx_users_role_status")
}

enum identity_documents_document_type {
  PAN
  AADHAAR
}

enum password_resets_purpose {
  ACTIVATION
  RESET
}

enum login_attempts_status {
  SUCCESS
  FAILURE
  LOCKED
}

enum users_status {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum project_document_kind {
  BROCHURE
  PHOTO
  SOCIETY_DRAWING
}

enum project_plot_status {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
  HOLD
  NOT_FOR_SALE
}

enum project_plot_type {
  NORMAL
  CORNER
  PARK_FACING
  ROAD_FACING
  PARK
  FACILITY
  PU
  INSTITUTIONAL
}

enum plot_template_shape {
  RECTANGLE
  TRAPEZOID
}

enum enquiry_status {
  NEW
  CONTACTED
  VISITED
  NEGOTIATION
  WON
  LOST
}
